<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#181818">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TIÊU ĐỀ DIALOG -->
        <TextView
            android:id="@+id/txtEditProfileTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CHỈNH SỬA HỒ SƠ"
            android:textColor="#B0B0B0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="18dp" />

        <!-- CHỌN AVATAR -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chọn ảnh đại diện:"
            android:textColor="#C5C5D2"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <!-- LƯỚI CHỌN AVATAR (6 MẪU) -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="6"
            android:rowCount="1"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false"
            android:useDefaultMargins="true"
            android:layout_marginBottom="20dp">

            <!-- Avatar 1: Compass (Teal) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnAvatar0"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="#E0E0E0"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_compass"
                    app:tint="#FFFFFF" />
            </androidx.cardview.widget.CardView>

            <!-- Avatar 2: User (Blue) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnAvatar1"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="#B0B0B0"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:tint="#FFFFFF" />
            </androidx.cardview.widget.CardView>

            <!-- Avatar 3: Gallery (Purple) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnAvatar2"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_gallery"
                    app:tint="#FFFFFF" />
            </androidx.cardview.widget.CardView>

            <!-- Avatar 4: Today (Orange) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnAvatar3"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="#CCCCCC"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_today"
                    app:tint="#FFFFFF" />
            </androidx.cardview.widget.CardView>

            <!-- Avatar 5: Edit (Pink) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnAvatar4"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="#D5D5D5"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="#FFFFFF" />
            </androidx.cardview.widget.CardView>

            <!-- Avatar 6: Help (Green) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnAvatar5"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="#E0E0E0"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_help"
                    app:tint="#FFFFFF" />
            </androidx.cardview.widget.CardView>
        </GridLayout>

        <!-- ĐIỆN THOẠI -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Số điện thoại:"
            android:textColor="#C5C5D2"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/edtEditProfilePhone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#000000"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:paddingHorizontal="12dp"
            android:inputType="phone"
            android:layout_marginBottom="16dp" />

        <!-- EMAIL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email:"
            android:textColor="#C5C5D2"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/edtEditProfileEmail"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#000000"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:paddingHorizontal="12dp"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="16dp" />

        <!-- ĐỊA CHỈ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Địa chỉ:"
            android:textColor="#C5C5D2"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/edtEditProfileAddress"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#000000"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:paddingHorizontal="12dp"
            android:inputType="text"
            android:layout_marginBottom="20dp" />

        <!-- NÚT ĐỔI MẬT KHẨU TÍCH HỢP -->
        <Button
            android:id="@+id/btnEditProfileChangePassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ĐỔI MẬT KHẨU TÀI KHOẢN"
            android:backgroundTint="#2D2D2D"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- CÁC NÚT ĐIỀU KHIỂN (LƯU / HỦY) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnEditProfileCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HỦY"
                android:backgroundTint="#2D2D2D"
                android:textColor="#C5C5D2"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnEditProfileSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LƯU THAY ĐỔI"
                android:backgroundTint="#00B0FF"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
