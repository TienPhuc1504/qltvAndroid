<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#151421"
    android:padding="16dp">

    <!-- KHUNG ĐĂNG KÝ MƯỢN TRỰC TIẾP -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardCheckoutForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#212030"
        app:cardCornerRadius="14dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="LẬP PHIẾU MƯỢN TẠI QUẦY"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:layout_marginEnd="8dp"
                    android:hint="Mã độc giả (DGxxxx)"
                    android:textColorHint="#B0A8B9"
                    app:boxStrokeColor="#6C63FF"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="#6C63FF">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtCheckoutReader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Mã sách"
                    android:textColorHint="#B0A8B9"
                    app:boxStrokeColor="#6C63FF"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="#6C63FF">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtCheckoutBook"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitCheckout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="XÁC NHẬN CHO MƯỢN (14 NGÀY)"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:backgroundTint="#6C63FF"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Ô Tìm kiếm phiếu mượn -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/searchLayoutBorrow"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Tìm theo độc giả, cuốn sách..."
        android:textColorHint="#B0A8B9"
        app:boxStrokeColor="#6C63FF"
        app:boxStrokeWidthFocused="2dp"
        app:hintTextColor="#6C63FF"
        app:layout_constraintTop_toBottomOf="@id/cardCheckoutForm"
        app:startIconDrawable="@android:drawable/ic_menu_search"
        app:startIconTint="#B0A8B9">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editSearchBorrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Danh sách phiếu mượn đang hoạt động -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewBorrows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchLayoutBorrow"
        tools:listitem="@android:layout/simple_list_item_2" />

    <TextView
        android:id="@+id/txtEmptyBorrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Không tìm thấy phiếu mượn nào!"
        android:textColor="#B0A8B9"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
