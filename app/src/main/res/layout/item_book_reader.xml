<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#212030"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtBookTitleReader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Python cơ bản"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtBookAuthorReader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="John Smith"
                    android:textColor="#B0A8B9"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtBookCategoryReader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#2E2C4D"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="Công nghệ"
                android:textColor="#B0A8B9"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="#2E2C4D" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtAvailabilityReader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Có sẵn: 3 / 8 quyển"
                android:textColor="#4CAF50"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Nút Yêu cầu mượn (cho sách giấy) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBorrowActionReader"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="MƯỢN SÁCH"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="#6C63FF"
                app:cornerRadius="6dp" />

            <!-- Nút Đọc Online (cho sách online) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReadOnlineReader"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="ĐỌC ONLINE"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="#00B0FF"
                app:cornerRadius="6dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
