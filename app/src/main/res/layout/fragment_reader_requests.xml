<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="16dp">

    <!-- Bộ chuyển đổi Tab Yêu Cầu Độc giả -->
    <LinearLayout
        android:id="@+id/tabBarLayoutReader"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@drawable/tab_bar_background"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnTabBorrowReader"
            style="@style/Widget.Material3.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Mượn Sách"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:backgroundTint="#00B0FF"
            app:cornerRadius="22dp" />

        <Button
            android:id="@+id/btnTabCardReader"
            style="@style/Widget.Material3.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Thẻ Độc Giả"
            android:textColor="#C5C5D2"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:backgroundTint="#00000000"
            app:cornerRadius="22dp" />
    </LinearLayout>

    <!-- Nút Yêu cầu in thẻ mới (chỉ hiện khi ở tab thẻ, dạng Floating Action Button ở góc dưới bên phải) -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btnNewCardRequest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Yêu Cầu Thẻ"
        android:textColor="#FFFFFF"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="#FFFFFF"
        app:backgroundTint="#00B0FF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Danh sách yêu cầu -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewMyRequests"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabBarLayoutReader"
        tools:listitem="@android:layout/simple_list_item_2" />

    <TextView
        android:id="@+id/txtEmptyMyRequest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bạn không có yêu cầu nào!"
        android:textColor="#C5C5D2"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
