<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#181818"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Thông tin sách -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtBookTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Python cơ bản"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtBookAuthor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="John Smith"
                    android:textColor="#C5C5D2"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Huy hiệu Loại sách -->
            <TextView
                android:id="@+id/badgeBookType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="SÁCH GIẤY"
                android:textColor="#B0B0B0"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Thể loại và Độ sẵn có -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Thể loại -->
            <TextView
                android:id="@+id/txtBookCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#2D2D2D"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="Công nghệ"
                android:textColor="#C5C5D2"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Trạng thái số lượng hoặc liên kết -->
            <TextView
                android:id="@+id/txtAvailability"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Có sẵn: 3 / 8 quyển"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Nút hành động cho Nhân viên -->
        <LinearLayout
            android:id="@+id/layoutActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal"
            tools:ignore="DisableBaselineAlignment">

            <Button
                android:id="@+id/btnManageCopies"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quản lý bản sao"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/btnEditBook"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Edit book"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="#B0B0B0" />

            <ImageView
                android:id="@+id/btnDeleteBook"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete book"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="#E0E0E0" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
