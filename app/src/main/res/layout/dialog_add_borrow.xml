<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#181818"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtFormTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="18dp"
            android:text="LẬP PHIẾU MƯỢN SÁCH MỚI"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Ô chọn độc giả -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Chọn độc giả"
            android:textColorHint="#C5C5D2"
            app:boxStrokeColor="#FFFFFF"
            app:boxStrokeWidthFocused="2dp"
            app:hintTextColor="#FFFFFF">

            <AutoCompleteTextView
                android:id="@+id/autoCompleteReader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Ô chọn đầu sách -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:hint="Chọn đầu sách"
            android:textColorHint="#C5C5D2"
            app:boxStrokeColor="#FFFFFF"
            app:boxStrokeWidthFocused="2dp"
            app:hintTextColor="#FFFFFF">

            <AutoCompleteTextView
                android:id="@+id/autoCompleteBook"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveBorrow"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="XÁC NHẬN CHO MƯỢN (14 NGÀY)"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#00B0FF"
            app:cornerRadius="10dp" />

    </LinearLayout>
</ScrollView>
