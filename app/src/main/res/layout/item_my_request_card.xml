<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#212030"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Yêu cầu: Cấp / In thẻ độc giả vật lý"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/badgeMyCardReqStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#2E2C4D"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="CHO_DUYET"
                android:textColor="#FF9800"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="#2E2C4D" />

        <TextView
            android:id="@+id/txtMyCardReqDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ngày yêu cầu: 2026-05-24 02:10"
            android:textColor="#B0A8B9"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtMyCardReqPickup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tình trạng nhận: Đã nhận thẻ tại quầy"
            android:textColor="#4CAF50"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtMyCardReqReason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Lý do từ chối: -"
            android:textColor="#FF5252"
            android:textSize="12sp"
            android:textStyle="italic"
            android:visibility="gone" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
