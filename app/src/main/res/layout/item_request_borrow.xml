<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#181818"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtReqReader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Trần Thị B (DG0001)"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/badgeReqStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#2D2D2D"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="CHO_DUYET"
                android:textColor="#CCCCCC"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="#2D2D2D" />

        <TextView
            android:id="@+id/txtReqBook"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yêu cầu mượn: Python cơ bản"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtReqProposed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Số ngày đề xuất: 14 ngày | Ghi chú: Cần mượn học thi"
            android:textColor="#C5C5D2"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtReqDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Ngày yêu cầu: 2026-05-24"
            android:textColor="#C5C5D2"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtReqRefuseReason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Lý do từ chối: -"
            android:textColor="#E0E0E0"
            android:textSize="12sp"
            android:textStyle="italic"
            android:visibility="gone" />

        <!-- Nút hành động thay đổi linh hoạt theo trạng thái -->
        <LinearLayout
            android:id="@+id/layoutReqActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRejectReq"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="TỪ CHỐI"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApproveReq"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:text="PHÊ DUYỆT"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmReqPickup"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:text="XÁC NHẬN LẤY SÁCH"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="#E0E0E0"
                app:cornerRadius="6dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
