<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#212030"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtReaderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trần Thị B"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtReaderCodePhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="DG0001 | SĐT: 0923456789"
                android:textColor="#B0A8B9"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Trạng thái thẻ độc giả -->
        <TextView
            android:id="@+id/badgeCardStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#2E2C4D"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="HOẠT ĐỘNG"
            android:textColor="#4CAF50"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
