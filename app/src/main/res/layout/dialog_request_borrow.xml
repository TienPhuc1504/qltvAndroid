<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#212030"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtBorrowDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:text="GỬI YÊU CẦU MƯỢN SÁCH"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Số ngày mượn đề xuất -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Số ngày đề xuất mượn (1 - 30)"
            android:textColorHint="#B0A8B9"
            app:boxStrokeColor="#6C63FF"
            app:boxStrokeWidthFocused="2dp"
            app:hintTextColor="#6C63FF">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtBorrowDialogDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="14"
                android:textColor="#FFFFFF" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Ghi chú mượn -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:hint="Ghi chú thêm"
            android:textColorHint="#B0A8B9"
            app:boxStrokeColor="#6C63FF"
            app:boxStrokeWidthFocused="2dp"
            app:hintTextColor="#6C63FF">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtBorrowDialogNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Nút gửi yêu cầu -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBorrowDialogSend"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="GỬI YÊU CẦU DUYỆT"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#6C63FF"
            app:cornerRadius="10dp" />
    </LinearLayout>
</ScrollView>
