<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="16dp">

    <!-- Bộ chuyển đổi Tab Yêu Cầu (Custom TabLayout) -->
    <LinearLayout
        android:id="@+id/tabBarLayout"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#181818"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnTabBorrow"
            style="@style/Widget.Material3.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Mượn Sách"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="6dp" />

        <Button
            android:id="@+id/btnTabCard"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="In Thẻ Độc Giả"
            android:textColor="#C5C5D2"
            android:textStyle="bold"
            app:cornerRadius="6dp" />
    </LinearLayout>

    <!-- Danh sách yêu cầu -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewRequests"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabBarLayout"
        tools:listitem="@android:layout/simple_list_item_2" />

    <TextView
        android:id="@+id/txtEmptyRequest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Không có yêu cầu nào!"
        android:textColor="#C5C5D2"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
