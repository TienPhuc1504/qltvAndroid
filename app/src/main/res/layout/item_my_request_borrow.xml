<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#212030"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtMyReqBook"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mượn: Python cơ bản"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/badgeMyReqStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#2E2C4D"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="CHO_DUYET"
                android:textColor="#FF9800"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="#2E2C4D" />

        <TextView
            android:id="@+id/txtMyReqDays"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đề xuất: 14 ngày | Ghi chú: Học thi"
            android:textColor="#B0A8B9"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtMyReqDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Ngày yêu cầu: 2026-05-24"
            android:textColor="#B0A8B9"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtMyReqReason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Lý do từ chối: -"
            android:textColor="#FF5252"
            android:textSize="12sp"
            android:textStyle="italic"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelMyReq"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="HỦY YÊU CẦU"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="#FF5252"
                app:cornerRadius="6dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
