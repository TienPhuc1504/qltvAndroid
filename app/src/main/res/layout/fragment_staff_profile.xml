<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <!-- THANH TIÊU ĐỀ ĐỘNG (HEADER BAR) -->
    <RelativeLayout
        android:id="@+id/layoutProfileHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#181818"
        android:paddingHorizontal="16dp">

        <!-- Nút quay lại (chỉ hiển thị khi đang xem Thống kê hoặc Quản lý nhân viên) -->
        <ImageView
            android:id="@+id/btnProfileBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_revert"
            android:visibility="gone"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/txtProfileHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="HỒ SƠ CỦA BẠN"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Nút ba chấm cho Đăng xuất -->
        <ImageView
            android:id="@+id/btnStaffProfileLogoutMenu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_more"
            app:tint="#FFFFFF" />
    </RelativeLayout>

    <!-- KHUNG CHỨA DỮ LIỆU ĐỘNG -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- PANEL 1: GIAO DIỆN CHÍNH (HỒ SƠ CÁ NHÂN & ĐIỀU HƯỚNG CÔNG CỤ) -->
        <ScrollView
            android:id="@+id/layoutStaffProfileHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 1. THẺ THÔNG TIN TÀI KHOẢN -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#181818"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Avatar tròn mô phỏng -->
                        <TextView
                            android:id="@+id/txtStaffProfileAvatar"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:background="@android:drawable/presence_online"
                            android:backgroundTint="#B0B0B0"
                            android:gravity="center"
                            android:text="A"
                            android:textColor="#FFFFFF"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtStaffProfileName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Họ và Tên"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtStaffProfileUsername"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="\@username"
                            android:textColor="#C5C5D2"
                            android:textSize="13sp" />

                        <!-- Badge Vai trò -->
                        <TextView
                            android:id="@+id/badgeStaffProfileRole"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="#2D2D2D"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:text="ADMIN"
                            android:textColor="#B0B0B0"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 2. THẺ CHI TIẾT CÁ NHÂN -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#181818"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Thông tin liên lạc"
                            android:textColor="#B0B0B0"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <!-- Mã nhân viên -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:text="Mã nhân viên:"
                                android:textColor="#C5C5D2"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/txtStaffProfileCode"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="NV0001"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Số điện thoại -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:text="Số điện thoại:"
                                android:textColor="#C5C5D2"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/txtStaffProfilePhone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="0912345678"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Email -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:text="Email:"
                                android:textColor="#C5C5D2"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/txtStaffProfileEmail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="email@example.com"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Địa chỉ -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:text="Địa chỉ:"
                                android:textColor="#C5C5D2"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/txtStaffProfileAddress"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Hà Nội"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Nút đổi mật khẩu -->
                <Button
                    android:id="@+id/btnStaffProfileChangePassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:backgroundTint="#2D2D2D"
                    android:text="ĐỔI MẬT KHẨU TÀI KHOẢN"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- 3. TIỆN ÍCH DÀNH CHO QUẢN TRỊ / THỦ THƯ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="TIỆN ÍCH HỆ THỐNG"
                    android:textColor="#C5C5D2"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Thống kê Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardStaffProfileStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#181818"
                    app:cardCornerRadius="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <View
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginRight="14dp"
                            android:background="@android:drawable/ic_menu_compass"
                            android:backgroundTint="#FFD700" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Báo cáo Thống kê"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Xem thống kê tổng quan thư viện và lượt mượn trả"
                                android:textColor="#C5C5D2"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="❯"
                            android:textColor="#B0B0B0"
                            android:textSize="16sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Quản lý Nhân viên Card (Chỉ dành cho ADMIN) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardStaffProfileStaffMgmt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#181818"
                    app:cardCornerRadius="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <View
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginRight="14dp"
                            android:background="@android:drawable/ic_menu_myplaces"
                            android:backgroundTint="#E0E0E0" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Quản lý Nhân viên"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Thêm, sửa và xóa thông tin nhân viên thư viện"
                                android:textColor="#C5C5D2"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="❯"
                            android:textColor="#B0B0B0"
                            android:textSize="16sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </ScrollView>

        <!-- PANEL 2: PANEL XEM THỐNG KÊ (ẨN MẶC ĐỊNH) -->
        <LinearLayout
            android:id="@+id/layoutStaffProfileStatsView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <include layout="@layout/fragment_statistics" />
        </LinearLayout>

        <!-- PANEL 3: PANEL QUẢN LÝ NHÂN VIÊN DÀNH CHO ADMIN (ẨN MẶC ĐỊNH) -->
        <RelativeLayout
            android:id="@+id/layoutStaffProfileStaffMgmtView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <!-- Ô tìm kiếm nhân viên -->
            <EditText
                android:id="@+id/editSearchStaff"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#181818"
                android:hint="Tìm kiếm nhân viên..."
                android:textColorHint="#C5C5D2"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="16dp"
                android:textSize="14sp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/txtEmptyStaff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Chưa có nhân viên nào!"
                android:textColor="#C5C5D2"
                android:textSize="14sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewStaff"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/editSearchStaff"
                android:layout_marginTop="12dp" />

            <!-- Nút thêm nhân viên mới -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabAddStaff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_alignParentRight="true"
                android:layout_margin="16dp"
                android:src="@android:drawable/ic_input_add"
                app:backgroundTint="#00B0FF"
                app:tint="#FFFFFF" />
        </RelativeLayout>
    </FrameLayout>
</LinearLayout>
