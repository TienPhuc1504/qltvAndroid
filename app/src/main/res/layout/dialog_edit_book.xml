<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#181818"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:text="CHỈNH SỬA ĐẦU SÁCH"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Tiêu đề -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Tiêu đề sách"
            android:textColorHint="#C5C5D2"
            app:boxStrokeColor="#FFFFFF"
            app:boxStrokeWidthFocused="2dp"
            app:hintTextColor="#FFFFFF">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtTitleEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Tác giả -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Tác giả"
            android:textColorHint="#C5C5D2"
            app:boxStrokeColor="#FFFFFF"
            app:boxStrokeWidthFocused="2dp"
            app:hintTextColor="#FFFFFF">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtAuthorEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Spinner Thể loại -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Thể loại"
            android:textColor="#C5C5D2"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/spinDialogCatEdit"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="12dp"
            android:background="@android:drawable/btn_dropdown"
            android:backgroundTint="#2D2D2D" />

        <!-- Trạng thái đầu sách giấy (hàng loạt) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Trạng thái (áp dụng bản sao chưa mượn)"
            android:textColor="#C5C5D2"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/spinBookStatusEdit"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="12dp"
            android:background="@android:drawable/btn_dropdown"
            android:backgroundTint="#2D2D2D" />

        <!-- Phần cấu hình Sách Online -->
        <LinearLayout
            android:id="@+id/layoutOnlineOnlyEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- URL tài liệu -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="URL tài liệu"
                android:textColorHint="#C5C5D2"
                app:boxStrokeColor="#FFFFFF"
                app:boxStrokeWidthFocused="2dp"
                app:hintTextColor="#FFFFFF">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtUrlEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:textColor="#FFFFFF" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Định dạng tài liệu -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Định dạng"
                android:textColorHint="#C5C5D2"
                app:boxStrokeColor="#FFFFFF"
                app:boxStrokeWidthFocused="2dp"
                app:hintTextColor="#FFFFFF">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtFormatEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveBookEdit"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:text="LƯU THAY ĐỔI"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#B0B0B0"
            app:cornerRadius="10dp" />

    </LinearLayout>
</ScrollView>
