<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#181818"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"
        android:text="IN THẺ ĐỘC GIẢ (PREVIEW)"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Thẻ Độc Giả Vật Lý Layout -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardLayout"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp">

        <!-- Background Gradient cho thẻ -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/login_gradient"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtCardApp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THƯ VIỆN SỐ QLTV"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/txtCardApp"
                android:text="LIBRARY MEMBER CARD"
                android:textColor="#B0B0B0"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtCardName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TRẦN THỊ B"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtCardCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="MÃ ĐG: DG0001"
                    android:textColor="#C5C5D2"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtCardExpiry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="HẠN THẺ: 2027-05-24"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCardPrintSubmit"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="XÁC NHẬN IN THẺ (PDF)"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:backgroundTint="#00B0FF"
        app:cornerRadius="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCardPrintClose"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="ĐÓNG"
        android:textColor="#C5C5D2" />

</LinearLayout>
